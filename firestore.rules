rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function ownedByMe() {
      return signedIn() && resource.data.studentId == request.auth.uid;
    }
    function creatingForMe() {
      return signedIn() && request.resource.data.studentId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /subjects/{subjectId} {
      allow read, update, delete: if ownedByMe();
      allow create: if creatingForMe();
    }

    match /notes/{noteId} {
      allow read, update, delete: if ownedByMe();
      allow create: if creatingForMe();
    }

    match /tasks/{taskId} {
      allow read, update, delete: if ownedByMe();
      allow create: if creatingForMe();
    }

    match /points_ledger/{entryId} {
      allow read: if ownedByMe();
      allow create: if creatingForMe();
    }
  }
}
